{
  "name": "skillbridge-ethiopia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:backend": "tsx backend/src/server.ts",
    "dev:frontend": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=esm --outfile=server.js --packages=external && esbuild backend/src/infrastructure/database/migrate.ts --bundle --platform=node --target=node20 --format=esm --outfile=migrate.js --packages=external && esbuild backend/src/infrastructure/database/provision-admin.ts --bundle --platform=node --target=node20 --format=esm --outfile=admin-provision.js --packages=external",
    "start": "node server.js",
    "clean": "rm -rf dist server.js migrate.js admin-provision.js",
    "lint": "tsc --noEmit",
    "db:create": "tsx backend/src/infrastructure/database/create-database.ts",
    "db:migrate": "tsx backend/src/infrastructure/database/migrate.ts",
    "db:inspect": "tsx backend/src/infrastructure/database/inspect.ts",
    "db:seed": "tsx backend/src/infrastructure/database/seed.ts",
    "admin:provision": "tsx backend/src/infrastructure/database/provision-admin.ts",
    "test": "tsx --test backend/src/config/security.test.ts backend/src/modules/jobs/jobs.test.ts backend/src/infrastructure/database/drizzle.test.ts backend/src/modules/auth/auth.security.test.ts backend/src/middleware/mysql-rate-limit-store.test.ts backend/src/modules/admin/admin.test.ts backend/src/modules/admin/admin.email-verification.test.ts backend/src/modules/admin/admin.management.test.ts backend/src/modules/admin/admin.reports.cache.test.ts backend/src/modules/admin/admin.reports.export.test.ts backend/src/modules/employers/employers.test.ts backend/src/modules/messaging/messaging.test.ts backend/src/modules/verification-documents/verification-documents.test.ts backend/src/modules/system/system.test.ts backend/src/modules/profile/profile.schemas.test.ts backend/src/modules/candidates/candidates.schemas.test.ts backend/src/modules/candidates/candidates.assessment.test.ts backend/src/modules/ai-nexus/ai-nexus.service.test.ts backend/src/modules/ai-nexus/ai-provider.service.test.ts",
    "test:integration": "tsx tests/integration/mysql-workflows.test.ts"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@fontsource/noto-sans-ethiopic": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-stringify": "^6.9.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "openai": "^6.49.0",
    "pdfkit": "^0.20.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "resend": "^6.34.1",
    "vite": "^8.3.0",
    "zod": "^4.6.5",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
