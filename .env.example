# Copy to .env locally or configure these values in the cPanel Node.js application.
# Never commit .env or replace the placeholders with credentials in source control.

# Required. Configure these values in the cPanel Node.js application.
PORT=3000
NODE_ENV=development
# Keep true/default for cPanel SPA hosting; Render API service sets this to false.
SERVE_FRONTEND=true

# Required. URL-encode reserved characters in the database password.
DATABASE_URL="mysql://root@127.0.0.1:3306/skillbridge_db?connection_limit=5"

# Local XAMPP test database only; never use a production URL.
# TEST_DATABASE_URL="mysql://skillbridge_test:PASSWORD@127.0.0.1:3306/skillbridge_test"

# Set ADMIN_PASSWORD only in the ignored local .env or protected deployment settings.
ADMIN_USERNAME="admin@skillbridge.ss"
ADMIN_PASSWORD=""

# Required. Generate a unique random secret of at least 32 characters for production.
JWT_SECRET="<GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>"

# Optional integrations/configuration.
CORS_ORIGIN=""
# Server-side AI provider secrets only. Never prefix with VITE_ or expose to the browser.
OPENAI_API_KEY="replace_with_new_openai_key"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_API_KEY="replace_with_new_gemini_key"
OPENAI_MODEL="gpt-4.1-nano"
AI_PRIMARY_PROVIDER="openai"
AI_FALLBACK_PROVIDER="gemini"
AI_REQUEST_TIMEOUT_MS="12000"
APP_URL="https://<YOUR_APP_DOMAIN>"
# Email OTP verification. Add the Resend API key to the server environment only.
RESEND_API_KEY=
OTP_FROM_EMAIL="SKILLBRIDGE ET <securityteam@kueiyiee.tech>"
EMAIL_OTP_SECRET="<GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>"
EMAIL_OTP_TTL_MINUTES="10"
EMAIL_VERIFICATION_URL="https://<YOUR_APP_DOMAIN>/verify-email"
APP_NAME="SKILLBRIDGE ET"
SUPPORT_EMAIL="support@<YOUR_DOMAIN>"
ML_SERVICE_URL="http://127.0.0.1:8000"
